# Hostinger Production Database Configuration
# (Found in Hostinger hPanel -> Databases -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_deuser
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=u123456789_deelearn

# Express Server Port (Hostinger sets PORT automatically in Node.js apps)
PORT=5000

# Security & JWT Token Secret (Generate a strong random string)
JWT_SECRET=replace_with_your_64_character_random_secret_string_here
JWT_EXPIRES_IN=7d

# Environment Mode
NODE_ENV=production

# Frontend URL (e.g., https://yourdomain.com)
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=/api
